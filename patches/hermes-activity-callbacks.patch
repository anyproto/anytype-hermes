--- /dev/null
+++ b/gateway/activity_callbacks.py
@@ -0,0 +1,53 @@
+"""Compose an opt-in adapter activity sink with the agent's existing UI callbacks."""
+
+import logging
+
+logger = logging.getLogger(__name__)
+
+
+def wire_activity_callbacks(agent, adapter, source, *, session_key, muted, is_current):
+    factory = getattr(type(adapter), "get_activity_callbacks", None)
+    if muted or not callable(factory):
+        return None
+    try:
+        callbacks = adapter.get_activity_callbacks(source, session_key=session_key)
+    except Exception:
+        logger.debug("Activity sink setup failed", exc_info=True)
+        return None
+    if not callbacks:
+        return None
+
+    def call(name, *args):
+        callback = callbacks.get(name)
+        if callback is not None:
+            try:
+                callback(*args)
+            except Exception:
+                logger.debug("Activity %s callback failed", name, exc_info=True)
+
+    def compose(previous, name):
+        def dispatch(*args):
+            try:
+                if previous is not None:
+                    previous(*args)
+            finally:
+                # Late starts from an old turn must not open new activity; its terminal
+                # callbacks still settle the matching old run, never the replacement run.
+                if name != "tool_start" or is_current():
+                    call(name, *args)
+        return dispatch
+
+    agent.tool_start_callback = compose(agent.tool_start_callback, "tool_start")
+    agent.tool_complete_callback = compose(agent.tool_complete_callback, "tool_complete")
+    previous_status = agent.status_callback
+
+    def status(event_type, text):
+        from gateway.warning_notifications import is_warning_status
+        if is_warning_status(event_type, text) or "status" not in callbacks:
+            if previous_status is not None:
+                previous_status(event_type, text)
+        elif is_current():
+            call("status", event_type, text)
+
+    agent.status_callback = status
+    return lambda: call("close")
